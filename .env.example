# Copy to .env for local development and fill in real values.
# NEVER commit .env. In production these are set in Netlify:
# Site configuration → Environment variables (scope: Functions, marked secret).

# Brevo API key (SMTP & API → API Keys).
BREVO_API_KEY=

# Comma-separated list of addresses that receive website enquiries.
ENQUIRY_TO_EMAIL=

# Verified Brevo sender address, e.g. noreply@jphbuilding.co.uk
ENQUIRY_FROM_EMAIL=
