---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ArrowRightIcon from "$components/Icons/ArrowRightIcon.astro";
import "$components/CraftsmanshipCards/CraftsmanshipCards.css";

interface Props {
  title: string;
  text: string;
  badge: string;
  image: ImageMetadata;
  imageAlt: string;
  linkLabel: string;
  href: string;
}

const { title, text, badge, image, imageAlt, linkLabel, href } = Astro.props;
---

<article class="craftsmanship-card technical-corner">
  <div class="craftsmanship-card__media">
    <Image
      src={image}
      alt={imageAlt}
      class="craftsmanship-card__image"
      widths={[400, image.width]}
      sizes="(min-width: 768px) 50vw, 100vw"
    />
    <span class="craftsmanship-card__badge">{badge}</span>
  </div>

  <div class="craftsmanship-card__body">
    <div class="craftsmanship-card__heading">
      <span class="craftsmanship-card__icon"><slot name="icon" /></span>
      <h3 class="craftsmanship-card__title">{title}</h3>
    </div>
    <p class="craftsmanship-card__text">{text}</p>
  </div>

  <div class="craftsmanship-card__footer">
    <a class="craftsmanship-card__link" href={href}>
      {linkLabel}
      <ArrowRightIcon />
    </a>
  </div>
</article>
