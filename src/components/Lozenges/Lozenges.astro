---
import "./Lozenges.css";

interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<div class="lozenge">
  <div class="lozenge__header">
    <span class="lozenge__icon"><slot name="icon" /></span>
    <span class="lozenge__title">{title}</span>
  </div>
  <p class="lozenge__text">{text}</p>
</div>
