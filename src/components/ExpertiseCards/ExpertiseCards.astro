---
import "$components/ExpertiseCards/ExpertiseCards.css";

interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<article class="expertise-card technical-corner">
  <div class="expertise-card__header">
    <span class="expertise-card__icon"><slot name="icon" /></span>
  </div>
  <h3 class="expertise-card__title">{title}</h3>
  <p class="expertise-card__text">{text}</p>
</article>
