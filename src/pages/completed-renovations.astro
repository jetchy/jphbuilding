import Enquiry from "$components/Enquiry/Enquiry.astro";
import GalleryGrid from "$components/GalleryGrid/GalleryGrid.astro";
import PageHero from "$components/PageHero/PageHero.astro";
---

<Layout
  title="Completed Renovations | JPH Building"
  description="See completed projects by JPH Building, a local Cheltenham builder. Extensions, barn conversions, kitchens, bathrooms, joinery and driveways across Gloucestershire."
>
  <PageHero
    title="Completed Renovations"
